local function onCharacterAdded(character)
    if not character then return end
    local hum = character:FindFirstChildOfClass("Humanoid")
    if not hum then
        hum = waitFor(character, "Humanoid", 5)
    end
    if not hum then return end

    local diedConn
    diedConn = hum.Died:Connect(function()
        if diedConn then
            pcall(function() diedConn:Disconnect() end)
            diedConn = nil
        end
        stopFly()
        stopWalk()
        table.clear(S.invis.backup)
    end)
end

LocalPlayer.CharacterAdded:Connect(onCharacterAdded)
if LocalPlayer.Character then
    onCharacterAdded(LocalPlayer.Character)
end

--==================== 12. 主循环 ====================
local acc = 0
local fpsCount = 0
local fpsTimer = os.clock()

RunService.Heartbeat:Connect(function(deltaTime)
    acc = acc + deltaTime
    fpsCount = fpsCount + 1

    if S.noclip then
        applyNoclip()
    end

    if acc >= CONFIG.espInterval then
        acc = 0
        updateESP()
        antiVoidTick()
        if S.third.on then
            pcall(function()
                LocalPlayer.CameraMode = Enum.CameraMode.Classic
            end)
        end
    end

    local now = os.clock()
    if now - fpsTimer >= 1 then
        local ping = 0
        pcall(function()
            local item = Stats.Network.ServerStatsItem["Data Ping"]
            if item then ping = math.floor(item:GetValue() + 0.5) end
        end)
        if statusLabel and statusLabel.Parent then
            statusLabel.Text = string.format("FPS %d  |  PING %dms  |  %s", fpsCount, ping, tostring(game.PlaceId))
        end
        fpsCount = 0
        fpsTimer = now
    end
end)

