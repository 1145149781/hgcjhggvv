local function resolveGlobal(name)
    local env = nil
    local ok, res = pcall(function()
        if getgenv then return getgenv() end
        return nil
    end)
    if ok then env = res end

    if env and type(env[name]) == "function" then
        return env[name]
    end
    if type(rawget(_G, name)) == "function" then
        return rawget(_G, name)
    end
    return nil
end

