-- 8.1 飞行
local function stopFly()
    S.fly.on = false
    if S.fly.conn then
        pcall(function() S.fly.conn:Disconnect() end)
        S.fly.conn = nil
    end
    if S.fly.bv then
        pcall(function() S.fly.bv:Destroy() end)
        S.fly.bv = nil
    end
    if S.fly.bg then
        pcall(function() S.fly.bg:Destroy() end)
        S.fly.bg = nil
    end
    local hum = getHum()
    if hum then
        pcall(function() hum.PlatformStand = false end)
    end
end

local function startFly()
    if S.fly.on then return end
    local ch = getChar()
    if not ch then
        notify("系统", "角色未就绪，无法起飞")
        return
    end
    local hum = getHum()
    local root = getRoot()
    if not hum or not root then
        notify("系统", "缺少 Humanoid / RootPart")
        return
    end

    S.fly.on = true
    pcall(function() hum.PlatformStand = true end)

    local bv = Instance.new("BodyVelocity")
    bv.Name = "SnowFlyVelocity"
    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.Velocity = Vector3.zero
    bv.Parent = root
    S.fly.bv = bv

    local bg = Instance.new("BodyGyro")
    bg.Name = "SnowFlyGyro"
    bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    bg.P = 3000
    bg.D = 60
    bg.Parent = root
    S.fly.bg = bg

    S.fly.conn = RunService.RenderStepped:Connect(function()
        if not S.fly.on then return end
        local curRoot = getRoot()
        if not curRoot or not S.fly.bv or not S.fly.bg then
            stopFly()
            return
        end
        local cam = workspace.CurrentCamera
        if not cam then return end

        local dir = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0, 1, 0) end
        if dir.Magnitude > 0 then
            dir = dir.Unit
        end
        S.fly.bv.Velocity = dir * S.fly.speed

        local look = curRoot.Position + cam.CFrame.LookVector
        if (look - curRoot.Position).Magnitude > 0.01 then
            S.fly.bg.CFrame = CFrame.lookAt(curRoot.Position, look)
        end
    end)
end

-- 8.2 加速（客户端位移）
local function stopWalk()
    S.walk.on = false
    if S.walk.conn then
        pcall(function() S.walk.conn:Disconnect() end)
        S.walk.conn = nil
    end
end

local function startWalk()
    if S.walk.on then return end
    S.walk.on = true
    S.walk.conn = RunService.Stepped:Connect(function(_, deltaTime)
        if not S.walk.on then return end
        local hum = getHum()
        local ch = getChar()
        if not hum or not ch then return end
        if hum.MoveDirection.Magnitude > 0 then
            local step = hum.MoveDirection * S.walk.speed * deltaTime * 10
            pcall(function() ch:TranslateBy(step) end)
        end
    end)
end

-- 8.3 透明
local function stopInvis()
    if S.invis.conn then
        pcall(function() S.invis.conn:Disconnect() end)
        S.invis.conn = nil
    end
    S.invis.on = false
    local ch = getChar()
    if ch then
        for part, data in pairs(S.invis.backup) do
            if typeof(part) == "Instance" and part.Parent then
                pcall(function()
                    part.Transparency = data.t
                    part.Material = data.m
                    part.Color = data.c
                end)
            end
        end
    end
    table.clear(S.invis.backup)
end

local function startInvis()
    if S.invis.on then return end
    S.invis.on = true
    S.invis.conn = RunService.Heartbeat:Connect(function()
        if not S.invis.on then return end
        local ch = getChar()
        if not ch then return end
        local hue = (os.clock() % 5) / 5
        local rainbow = Color3.fromHSV(hue, 1, 1)
        for _, part in ipairs(ch:GetDescendants()) do
            if part:IsA("BasePart") then
                if part.Name == "Head" then
                    if S.invis.backup[part] == nil then
                        S.invis.backup[part] = { t = part.Transparency, m = part.Material, c = part.Color }
                    end
                    part.Transparency = 1
                    local face = part:FindFirstChild("face")
                    if face then pcall(function() face:Destroy() end) end
                elseif part.Name ~= "HumanoidRootPart" then
                    if S.invis.backup[part] == nil then
                        S.invis.backup[part] = { t = part.Transparency, m = part.Material, c = part.Color }
                    end
                    part.Material = Enum.Material.ForceField
                    part.Color = rainbow
                    part.Transparency = 0.5
                end
            end
        end
    end)
end

-- 8.4 第三人称
local function applyThird(on)
    S.third.on = on
    if on then
        if not S.third.saved then
            S.third.saved = {
                mode = LocalPlayer.CameraMode,
                max = LocalPlayer.CameraMaxZoomDistance,
                min = LocalPlayer.CameraMinZoomDistance,
            }
        end
        pcall(function()
            LocalPlayer.CameraMode = Enum.CameraMode.Classic
            LocalPlayer.CameraMaxZoomDistance = 20
            LocalPlayer.CameraMinZoomDistance = 3
        end)
    else
        local saved = S.third.saved
        pcall(function()
            if saved then
                LocalPlayer.CameraMode = saved.mode
                LocalPlayer.CameraMaxZoomDistance = saved.max
                LocalPlayer.CameraMinZoomDistance = saved.min
            else
                LocalPlayer.CameraMode = Enum.CameraMode.Classic
            end
        end)
        S.third.saved = nil
    end
end

-- 8.5 连跳
local function applyJump(on)
    S.jump.on = on
    if S.jump.conn then
        pcall(function() S.jump.conn:Disconnect() end)
        S.jump.conn = nil
    end
    if on then
        S.jump.conn = UIS.JumpRequest:Connect(function()
            if not S.jump.on then return end
            local hum = getHum()
            if hum and hum.Health > 0 then
                pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
            end
        end)
    end
end

-- 8.6 穿墙
local function applyNoclip()
    local ch = getChar()
    if not ch then return end
    local value = not S.noclip
    for _, part in ipairs(ch:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = value
        end
    end
end

-- 8.7 防虚空
local function antiVoidTick()
    if not S.antiVoid then return end
    local root = getRoot()
    if not root then return end
    local destroyHeight = workspace.FallenPartsDestroyHeight
    if destroyHeight ~= destroyHeight then  -- NaN 保护
        return
    end
    if root.Position.Y <= destroyHeight + CONFIG.antiVoidMargin then
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.new(0, CONFIG.antiVoidPush, 0)
        end)
    end
end

-- 8.8 ESP
local function clearESP()
    for char, rec in pairs(S.esp.cache) do
        if rec.gui then
            pcall(function() rec.gui:Destroy() end)
        end
        S.esp.cache[char] = nil
    end
end

local function updateESP()
    if not S.esp.on then
        clearESP()
        return
    end

    local myRoot = getRoot()
    if not myRoot then return end

    local alive = {}

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local ch = plr.Character
            if ch then
                local head = ch:FindFirstChild("Head") or ch:FindFirstChildWhichIsA("BasePart")
                local root = ch:FindFirstChild("HumanoidRootPart") or head
                if head and root then
                    alive[ch] = true
                    local rec = S.esp.cache[ch]
                    if not rec then
                        local bb = Instance.new("BillboardGui")
                        bb.Name = "SnowESP"
                        bb.Size = UDim2.new(0, 220, 0, 52)
                        bb.StudsOffsetWorldSpace = Vector3.new(0, 2.6, 0)
                        bb.AlwaysOnTop = true
                        bb.MaxDistance = 3000
                        bb.Parent = head

                        local lbl = Instance.new("TextLabel")
                        lbl.Size = UDim2.new(1, 0, 1, 0)
                        lbl.BackgroundTransparency = 1
                        lbl.Font = Enum.Font.Gotham
                        lbl.TextSize = 12
                        lbl.RichText = true
                        lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
                        lbl.TextStrokeTransparency = 0.35
                        lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                        lbl.TextYAlignment = Enum.TextYAlignment.Top
                        lbl.Text = plr.Name
                        lbl.Parent = bb

                        rec = { gui = bb, label = lbl }
                        S.esp.cache[ch] = rec
                    end

                    local dist = math.floor((root.Position - myRoot.Position).Magnitude + 0.5)
                    local hum = ch:FindFirstChildOfClass("Humanoid")
                    local hp = 0
                    local mhp = 0
                    if hum then
                        hp = math.floor(hum.Health + 0.5)
                        mhp = math.floor(hum.MaxHealth + 0.5)
                    end

                    local lines = {}
                    if S.esp.name then
                        table.insert(lines, plr.Name)
                    end
                    if S.esp.dist then
                        table.insert(lines, string.format("距离 %dm", dist))
                    end
                    if S.esp.hp then
                        local ratio = 1
                        if mhp > 0 then ratio = hp / mhp end
                        local r = math.floor((1 - ratio) * 255)
                        local g = math.floor(ratio * 255)
                        table.insert(lines, string.format("<font color='rgb(%d,%d,0)'>HP %d/%d</font>", r, g, hp, mhp))
                    end
                    rec.label.Text = table.concat(lines, "\n")
                end
            end
        end
    end

    for char, rec in pairs(S.esp.cache) do
        if not alive[char] then
            if rec.gui then pcall(function() rec.gui:Destroy() end) end
            S.esp.cache[char] = nil
        end
    end
end

