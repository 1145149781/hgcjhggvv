local adminIds = {}
local blacklistIds = {}

local function loadRemoteList(url, label)
    if not CONFIG.remote.enabled then
        return nil
    end
    local ok, data = pcall(function()
        local body = game:HttpGet(url, true)
        local chunk = loadstring(body)
        if not chunk then
            return nil
        end
        local res = chunk()
        if type(res) ~= "table" then
            return nil
        end
        local out = {}
        for _, v in pairs(res) do
            if type(v) == "number" or type(v) == "string" then
                table.insert(out, tonumber(v) or v)
            end
        end
        return out
    end)
    if ok and data then
        notify("远端", string.format("%s 加载 %d 条", label, #data))
        return data
    end
    notify("远端", label .. " 加载失败（地址可能已失效）")
    return nil
end

