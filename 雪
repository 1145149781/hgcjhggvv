local function makeSlider(text, minValue, maxValue, default, callback)
    if maxValue <= minValue then
        maxValue = minValue + 1
    end

    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, -8, 0, 46)
    holder.BackgroundColor3 = Color3.fromRGB(28, 38, 56)
    holder.BorderSizePixel = 0
    holder.LayoutOrder = nextOrder()
    holder.Parent = scroll
    do
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 6)
        c.Parent = holder
    end

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -16, 0, 20)
    lbl.Position = UDim2.new(0, 8, 0, 3)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextColor3 = Color3.fromRGB(214, 230, 248)
    lbl.Parent = holder

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, -16, 0, 9)
    bar.Position = UDim2.new(0, 8, 0, 28)
    bar.BackgroundColor3 = Color3.fromRGB(46, 60, 84)
    bar.BorderSizePixel = 0
    bar.Parent = holder
    do
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 4)
        c.Parent = bar
    end

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(76, 201, 240)
    fill.BorderSizePixel = 0
    fill.Parent = bar
    do
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 4)
        c.Parent = fill
    end

    local value = default

    local function apply(v, fire)
        v = math.clamp(v, minValue, maxValue)
        value = v
        local alpha = (v - minValue) / (maxValue - minValue)
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        lbl.Text = string.format("%s : %d", text, math.floor(v + 0.5))
        if fire and callback then
            local ok, err = pcall(callback, v)
            if not ok then notify("错误", tostring(err)) end
        end
    end

    local dragging = false

    local function fromInput(input)
        local width = math.max(bar.AbsoluteSize.X, 1)
        local rel = (input.Position.X - bar.AbsolutePosition.X) / width
        rel = math.clamp(rel, 0, 1)
        apply(minValue + rel * (maxValue - minValue), true)
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            fromInput(input)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            fromInput(input)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    apply(default, false)

    return {
        Set = function(v) apply(v, true) end,
        Get = function() return value end,
    }
end

